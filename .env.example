# Frontend configuration (exposed to the browser — PUBLIC values only).
# Get these from `npx supabase status` (local) or Project Settings → API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put SUPABASE_SERVICE_ROLE_KEY, a secret key or a database password
# in any VITE_* variable — everything prefixed VITE_ ships to the browser.
